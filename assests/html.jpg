        <form action="https://portfolio-phi-henna-72.vercel.app/#" id="contact-form">
          <fieldset>
            <legend>
              <span>Contact</span>
              Me !
            </legend>

            <div class="fields">
              <div>
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" placeholder="John Doe" required="">
              </div>

              <div>
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" placeholder="jogn@gmail.com" required="">
              </div>

              <div>
                <label for="phone">Phone:</label>
                <input type="tel" id="phone" name="phone" placeholder="+91 8446496766" required="">
              </div>

              <div>
                <label for="message">Message:</label>
                <textarea name="message" id="message" cols="30" rows="5" placeholder="Hi Coding Tiger ! " required=""></textarea>
              </div>
            </div>

            <button type="submit" class="btn" id="send-msg">
              Send Message
            </button>
          </fieldset>
        </form>
